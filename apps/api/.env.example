PORT=4000
CORS_ORIGINS=http://localhost:8081
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Bank linking. Leave any of these empty and the bank routes answer 503.
# Server-side only: never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
# Sandbox host to confirm in the Finverse developer portal.
FINVERSE_BASE_URL=https://api.sandbox.finverse.net
FINVERSE_CLIENT_ID=
FINVERSE_CLIENT_SECRET=
# Must be reachable by Finverse and registered as a redirect URI in the portal.
FINVERSE_REDIRECT_URI=http://localhost:4000/link/callback
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
APP_REDIRECT_URLS=http://localhost:8081/linked,finpal://linked,exp://*
